# SERVER CONFIG
NODE_ENV=development
PORT=1234

# JWT CONFIG
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_TIME=3h

# DATABASE 
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432          
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password          
DB_DATABASE=bookstore_db
DB_SYNCHRONIZE=false

CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# EXP
EXP_DEFAULT=3d
EXP_VERIFICATION=1d
EXP_RESETPASSWORD=1h

# REDIS 
REDIS_HOST=localhost
REDIS_PORT=6379       
REDIS_PASSWORD=        
REDIS_DB=0            

# STORAGE
MULTER_DEST="./uploads"

# SLACK WEBHOOK
# SLACK_WEBHOOK_URL=your_slack_webhook_url_here

# DISCORD WEBHOOK
DISCORD_WEBHOOK_URL_LOG=your_discord_log_webhook_url
DISCORD_WEBHOOK_URL_UPDATE=your_discord_update_webhook_url
DISCORD_WEBHOOK_URL_ORDER=your_discord_order_webhook_url

# MAIL
MAIL_HOST=smtp.gmail.com
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_FROM="Book Store"
MAIL_PORT=465
MAIL_SECURE=true

# AI API CONFIG 
OPENAI_API_KEY=your_openai_api_key_here

# FE & OAuth Config
FRONTEND_URL=http://localhost:3000

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:4000/apis/v1/auth/google/callback

WEBAUTHN_RPID=localhost
ORIGIN=http://localhost:3000

# VNPAY
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:4000/apis/v1/payment/vnpay/return